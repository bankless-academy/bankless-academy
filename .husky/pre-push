#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# The gates `yarn build` runs before `next build` (~2s), so a content mistake
# fails here instead of after a 6-minute Vercel build. Quiet on success: these
# print ~60 lines of known warnings. Not `type-check` — 9 pre-existing errors.
if ! out=$(node validate-content.js 2>&1 && node validate-i18n.js 2>&1 && node test-content.js 2>&1); then
  printf '%s\n' "$out"
  echo ""
  echo "pre-push: content gates FAILED — this would also fail the Vercel build."
  exit 1
fi
echo "pre-push: content gates passed"
