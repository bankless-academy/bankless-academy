# Copy to .env and fill in what you need. Almost everything is optional for
# local development: the app runs without keys, the features behind them just
# stay disabled. Vars actually referenced in code, grouped by what they unlock.

# --- Database (Postgres via Knex; migrations/ + db.js) ----------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_DATABASE=postgres
DB_PASSWORD=

# --- Content pipeline -------------------------------------------------------
# AI lesson translation (translate-content.js)
ANTHROPIC_API_KEY=
# Suggest-changes form -> GitHub issues (api/suggest-content.ts).
# Fine-grained PAT, repo scope, Issues: read+write.
GITHUB_TOKEN=

# --- Notion (Explore products DB, announcements, FAQ/about/legal pages) -----
NOTION_SECRET=
DEFAULT_CONTENT_DB_ID=
DEFAULT_KEYWORD_DB_ID=
DEFAULT_MODULE_DB_ID=
DEFAULT_CONFIG_DB_ID=

# --- Chain access -----------------------------------------------------------
NEXT_PUBLIC_ALCHEMY_KEY=
ALCHEMY_KEY=
ALCHEMY_KEY2=
INFURA_KEY=
RPC_URL=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
# Badge minting: 'dev' | 'prod'
NEXT_PUBLIC_BADGE_ENV=dev
# Signer used to mint badges — keep out of any shared environment
PRIVATE_KEY=

# --- Coinbase smart wallet / paymaster -------------------------------------
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
PAYMASTER_SERVICE_URL=

# --- Sessions & auth (SIWE via iron-session) -------------------------------
NEXT_PUBLIC_SIWE_ENABLED=false
IRON_PASSWORD=
DEV_SECRET=

# --- Vercel KV (cache for explore / announcements / leaderboard) -----------
KV_URL=

# --- Gitcoin Passport & stamps ---------------------------------------------
GITCOIN_PASSPORT_API_KEY=
IAM_JWK=
NEXT_PUBLIC_STAMP_CALLBACK=
NEXT_PUBLIC_BRIGHTID_CLIENT_ID=
BRIGHTID_PRIVATE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
NEXT_PUBLIC_FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
NEXT_PUBLIC_TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CLIENT_API_KEY=
TWITTER_BEARER_TOKEN=
# Self (proof of personhood)
NEXT_PUBLIC_SELF_ENDPOINT=
NEXT_PUBLIC_SELF_SCOPE=
NEXT_PUBLIC_SELF_STAGING=

# --- Third-party data & identity -------------------------------------------
AIRSTACK_API_KEY=
NEYNAR_API_KEY=
UD_SECRET_API_TOKEN=
HUGGINGFACE_API_KEY=
GOOGLE_CLOUD_CREDENTIALS=

# --- Email & newsletter -----------------------------------------------------
SENDGRID_API_KEY=
MAILCHIMP_API_KEY=
PARAGRAPH_API_COOKIE=

# --- Analytics & monitoring -------------------------------------------------
NEXT_PUBLIC_MIXPANEL_PROJECT_ID=
UMAMI_ID=
NEXT_PUBLIC_SENTRY_ENABLED=false

# --- Feature flags ----------------------------------------------------------
NEXT_PUBLIC_MAINTENANCE=false
NEXT_PUBLIC_MD_ENABLED=false
NEXT_PUBLIC_DISCLAIMER_ENABLED=false
NEXT_PUBLIC_TOKEN_GATING_ENABLED=false

# --- Misc -------------------------------------------------------------------
PROJECT_DIR=
